{
  "name": "lark-card-builder",
  "version": "0.2.1",
  "private": true,
  "description": "Typed fluent builder and compiler for Feishu Card JSON 2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lark-card": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "scripts/lark-card.mjs",
    "docs/snapshot.json",
    "SKILL.md",
    "agents/openai.yaml",
    "references/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm bundle:cli",
    "bundle:cli": "node scripts/build-standalone-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
